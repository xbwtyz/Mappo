{
  "name": "mappo",
  "version": "0.2.25-dev",
  "private": true,
  "type": "module",
  "description": "Offline-first procedural medieval city mapper",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "check": "npm run build && npm run test",
    "test:node": "npm test",
    "test:node:shard:1": "node --test --test-shard=1/2 tests/*.test.js",
    "test:node:shard:2": "node --test --test-shard=2/2 tests/*.test.js",
    "test:browser": "npm run test:browser:workspace && npm run test:browser:property && npm run test:browser:integration",
    "test:browser:workspace": "npm run test:browser:desktop && npm run test:browser:roads",
    "test:browser:desktop": "node scripts/run-browser-suite.mjs desktop",
    "test:browser:roads": "node scripts/run-browser-suite.mjs roads",
    "test:browser:property": "node scripts/run-browser-suite.mjs property",
    "test:browser:integration": "node scripts/run-browser-suite.mjs integration",
    "test:browser:p2": "node scripts/c7-p2-browser-qa.mjs",
    "test:full": "npm run check && npm run test:browser",
    "test:browser:g4": "node scripts/g4-desktop-acceptance-browser-qa.mjs && node scripts/g4-cross-editor-browser-qa.mjs",
    "test:browser:h2": "node scripts/h2-save-compatibility-browser-qa.mjs",
    "test:browser:h4": "node scripts/h4-recovery-browser-qa.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
